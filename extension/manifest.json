{
  "manifest_version": 3,
  "name": "Internship Engine",
  "version": "0.2.0",
  "description": "Fit scores, one-click save, and honest autofill for internship applications. Works with the local engine or the hosted app.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://omar-colab.github.io/internship-engine/app/*", "https://omar-colab.github.io/internship-engine/feed.json"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Internship Engine" },
  "content_scripts": [{
    "matches": [
      "https://*.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*",
      "https://*.myworkdayjobs.com/*", "https://*.icims.com/*", "https://*.ultipro.com/*",
      "https://*.oraclecloud.com/*", "https://*.smartrecruiters.com/*", "https://*.jobvite.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://omar-colab.github.io/internship-engine/app/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }],
  "icons": { "128": "icon.png" }
}
